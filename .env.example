# Copy this file to .env before the first startup. Do not commit .env.
# Generate the secrets with the commands in README.md; they must remain secret.
API_KEY=
# Set to 1 when Caddy terminates HTTPS.
SESSION_COOKIE_SECURE=0
# Caddy's private IP/CIDR, for example 10.0.1.20/32.
TRUSTED_PROXIES=
GCM_BOOTSTRAP_ADMIN_TOKEN=
GCM_BOOTSTRAP_ADMIN_NAME=Administrator
