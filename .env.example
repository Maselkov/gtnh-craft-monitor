# Optional: the server runs without a .env. Copy this file to .env to set
# any of these (see "Configuration" in docs/server.md). Do not commit .env.

# The in-game scripts' shared secret, 32+ characters. Unset, one is
# generated into server/data/api_key on first start.
#API_KEY=
# Set to 1 when a reverse proxy terminates HTTPS.
#SESSION_COOKIE_SECURE=0
# The proxy's private IP/CIDR, for example 10.0.1.20/32.
#TRUSTED_PROXIES=
# Discord (or other) webhook URLs for notifications, comma-separated,
# and the page's public URL for icons and links in them.
#WEBHOOK_URLS=
#PUBLIC_URL=
